# GEMINI_API_KEY: Optional for Gemini AI features.
GEMINI_API_KEY=

# APP_URL: Base URL where the app is hosted
APP_URL=http://localhost:3000

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/omnitools

# REDIS_URL: Redis queue & cache connection string
REDIS_URL=redis://localhost:6379

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET=your-secure-random-jwt-secret-key

# Storage & Upload limits
STORAGE_CONFIG={"driver":"local","uploadDir":"./uploads","maxFileSizeMb":50}

# Email notification configuration
EMAIL_CONFIG={"smtpHost":"smtp.mailtrap.io","smtpPort":587,"smtpUser":"","smtpPass":""}

# Payment & Monetization
PAYMENT_CONFIG={"provider":"stripe","publishableKey":"","secretKey":""}

# Analytics & AdSense
ANALYTICS_CONFIG={"enabled":true,"trackEvents":true}
ADSENSE_CONFIG={"publisherId":"ca-pub-0000000000000000","enableHeader":true,"enableSidebar":true}

